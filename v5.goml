package uuid;

pub fn namespace_dns() -> Uuid {
    Uuid::from_u64_pair(0x6ba7b8109dad11d1, 0x80b400c04fd430c8)
}

pub fn namespace_url() -> Uuid {
    Uuid::from_u64_pair(0x6ba7b8119dad11d1, 0x80b400c04fd430c8)
}

pub fn namespace_oid() -> Uuid {
    Uuid::from_u64_pair(0x6ba7b8129dad11d1, 0x80b400c04fd430c8)
}

pub fn namespace_x500() -> Uuid {
    Uuid::from_u64_pair(0x6ba7b8149dad11d1, 0x80b400c04fd430c8)
}

fn sha1_rotate(value: u32, shift: u32) -> u32 {
    (value << shift) | (value >> (32 - shift))
}

impl Uuid {
    pub fn v5(namespace: Uuid, name: Slice[byte]) -> Uuid {
        let state: Vec[u32] = Vec::from_array(
            [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0],
        );
        let block: Vec[byte] = Vec::new();
        let prefix = namespace.to_bytes();
        for octet in prefix {
            block.push(octet);
        }
        for octet in name {
            block.push(octet);
            if block.len() == 64 {
                sha1_block(state, block);
                block.clear();
            }
        }
        let bits = (name.len().to_u64() + 16) * 8;
        block.push(128);
        if block.len() > 56 {
            while block.len() < 64 {
                block.push(0);
            }
            sha1_block(state, block);
            block.clear();
        }
        while block.len() < 56 {
            block.push(0);
        }
        for index in 0..8 {
            block.push((bits >> ((7 - index) * 8).to_u64()).to_u8());
        }
        sha1_block(state, block);
        let high = (state[0].to_u64() << 32) | state[1].to_u64();
        let low = (state[2].to_u64() << 32) | state[3].to_u64();
        Uuid::from_u64_pair(
            (high & 0xffffffffffff0fff) | 0x5000,
            (low & 0x3fffffffffffffff) | 0x8000000000000000,
        )
    }
}

fn sha1_block(state: Vec[u32], block: Vec[byte]) -> () {
    let words: Vec[u32] = Vec::new();
    for index in 0..16 {
        let start = index * 4;
        words.push(
            (block[start].to_u32() << 24) | (block[start + 1].to_u32() << 16)
                | (block[start + 2].to_u32() << 8)
                | block[start + 3].to_u32(),
        );
    }
    for index in 16..80 {
        words.push(
            sha1_rotate(
                words[index - 3] ^ words[index - 8] ^ words[index - 14] ^ words[index - 16],
                1,
            ),
        );
    }
    let mut a = state[0];
    let mut b = state[1];
    let mut c = state[2];
    let mut d = state[3];
    let mut e = state[4];
    for index in 0..80 {
        let (f, k) = if index < 20 {
            ((b & c) | ((b ^ 0xffffffff) & d), 0x5a827999.to_u32())
        } else if index < 40 {
            (b ^ c ^ d, 0x6ed9eba1.to_u32())
        } else if index < 60 {
            ((b & c) | (b & d) | (c & d), 0x8f1bbcdc.to_u32())
        } else {
            (b ^ c ^ d, 0xca62c1d6.to_u32())
        };
        let next = sha1_rotate(a, 5) + f + e + k + words[index];
        e = d;
        d = c;
        c = sha1_rotate(b, 30);
        b = a;
        a = next;
    }
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
}
