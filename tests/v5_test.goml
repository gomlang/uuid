package tests;

use ecosystem::uuid;
use ecosystem::uuid::{Uuid, Variant};
use std::testing;

#[test]
fn uuid_v5_reference_vectors() -> () {
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"".as_slice(),
    );
    testing::assert_eq(value.to_string(), "4ebd0208-8328-5d69-8c44-ec50939c0967");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x77\x77\x77\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d".as_slice(),
    );
    testing::assert_eq(value.to_string(), "2ed6657d-e927-568b-95e1-2665a8aea6a2");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x70\x79\x74\x68\x6f\x6e\x2e\x6f\x72\x67".as_slice(),
    );
    testing::assert_eq(value.to_string(), "886313e1-3b8a-5372-9b90-0c9aee199e5d");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff".as_slice(),
    );
    testing::assert_eq(value.to_string(), "1b4145f3-8e10-5f5e-9a5d-4bb90029b5ef");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78".as_slice(),
    );
    testing::assert_eq(value.to_string(), "2f80c0d1-1c62-579f-8d68-e61ad5592c9b");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78".as_slice(),
    );
    testing::assert_eq(value.to_string(), "e56fd57a-7633-5e1d-8f80-70e05ac413e5");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78".as_slice(),
    );
    testing::assert_eq(value.to_string(), "a112377b-8258-5ef7-b5b0-d2540bc03abb");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78".as_slice(),
    );
    testing::assert_eq(value.to_string(), "83993b6c-dea9-55ca-be5b-9989c85943fc");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78".as_slice(),
    );
    testing::assert_eq(value.to_string(), "a0f0b33b-afbf-5cad-b334-d8140d5af575");
    testing::assert(value.version() == Option::Some(5));
    testing::assert_eq(value.variant(), Variant::Rfc9562);
    let value = Uuid::v5(
        testing::expect_ok(Uuid::parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), "namespace"),
        b"\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x78\x